{
  "name": "yidocs",
  "version": "0.1.0",
  "description": "Translate and localize documentation with AI.",
  "main": "dist/index.js",
  "bin": {
    "yidocs": "./bin/yidocs.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "check": "npm run lint && tsc --noEmit"
  },
  "keywords": [
    "documentation",
    "translation",
    "ai",
    "deepseek",
    "localization",
    "vitepress"
  ],
  "author": "YiDocs Contributors",
  "license": "MIT",
  "dependencies": {
    "@types/prompts": "^2.4.9",
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "giget": "^1.2.1",
    "globby": "^14.0.1",
    "gray-matter": "^4.0.3",
    "openai": "^4.28.0",
    "ora": "^8.0.1",
    "p-limit": "^5.0.0",
    "prompts": "^2.4.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
